{
  "name": "@motoja/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.6",
    "expo-application": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.4",
    "expo-location": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.5",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-signature-canvas": "^5.1.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node --import tsx --test src/domain.test.ts",
    "export:android": "expo export --platform android --output-dir dist/android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "apk:local": "cd android && ./gradlew assembleDebug",
    "apk:preview:local": "NODE_ENV=production sh -c 'cd android && ./gradlew assembleRelease'",
    "apk:eas": "npx eas-cli@21.0.1 build --platform android --profile preview",
    "aab:eas": "npx eas-cli@21.0.1 build --platform android --profile production"
  },
  "private": true
}
